{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "ignorePatterns": [
    "simon-game/**"
  ],
  "rules": {
    "no-unused-vars": ["warn"],
    "no-console": "off",
    "quotes": ["error", "single"],
    "no-empty": "off"
  }
}